# Copie para .env e preencha. O .env não vai para o Git.

# Subdomínio que aponta para este servidor (registro A no DNS)
DOMINIO=reels.seudominio.com.br

# Senha do painel web (usuário qualquer). Obrigatória: o painel fica público na internet.
PAINEL_SENHA=

# Bot do Telegram (opcional): token do @BotFather e quem pode usar (IDs ou @usuários)
TELEGRAM_TOKEN=
TELEGRAM_AUTORIZADOS=

# Chave da API do Claude (opcional): sugestões de destaque, etiqueta e legenda
ANTHROPIC_API_KEY=
